rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── USER DATA: Strictly isolated per user ───────────────────────────
    // Controls settings, streaks, video progress, chapter mastery, quiz attempts,
    // mastered items, spaced repetition cards, mistake notebook, exam simulations,
    // notes, and PDF annotations.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Recursive rule for all subcollections under the user's document
      // Covers:
      // - users/{uid}/settings/preferences
      // - users/{uid}/stats/streak
      // - users/{uid}/study_activity/{dateStr}
      // - users/{uid}/video_progress/{videoId}
      // - users/{uid}/chapter_mastery/{chapterId}
      // - users/{uid}/quiz_attempts/{attemptId}
      // - users/{uid}/mastered_items/{itemId}
      // - users/{uid}/spaced_reviews/{itemId}
      // - users/{uid}/error_vault/{questionId}
      // - users/{uid}/exam_simulations/{simulationId}
      // - users/{uid}/notes/{noteId}
      // - users/{uid}/pdf_annotations/{docHash}
      // - users/{uid}/pdf_bookmarks/{docHash}
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── PUBLIC CURRICULUM & RESOURCES (Read-Only) ────────────────────────
    // Allows any client to read curriculum manifests, formulas, sample papers,
    // and announcements. Writes are blocked to prevent unauthorized modifications.
    match /curriculum/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /formulas/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /sample_papers/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /announcements/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ─── DEFAULT FALLBACK: Deny all unmatched paths ───────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
